# 配置说明: 本框架以 config/config.yaml 为主要配置入口, 环境变量仅作覆盖用.
# 复制为 .env 后按需修改; 也可直接在 config/config.yaml 中配置.

AUCTION_HTTP_BASE_URL=http://localhost:8080
AUCTION_WS_URL=ws://localhost:8080/ws/websocket
AUCTION_API_TIMEOUT=5
AUCTION_DEFAULT_PASSWORD=123456
K6_BIN=k6
AUCTION_REPORT_TYPE=allure

# 可选：绑定 k6 摘要到指定部署版本；未设置时使用 OpenAPI 指纹校验。
# BACKEND_VERSION=dev-2026-08-11

# 可选：k6 摘要最大有效期（小时），默认 24。
# K6_SUMMARY_MAX_AGE_HOURS=24
